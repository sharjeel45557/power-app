{
  "name": "@power-app/connectors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Connector framework + MS Graph/SharePoint, REST/FHIR, and in-memory connectors.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
