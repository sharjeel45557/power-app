# ──────────────────────────────────────────────────────────────────────────
#  power-app — environment configuration
#
#  Copy this file to `.env` for local development. In Cloud Foundry these are
#  supplied via `cf set-env` / a user-provided service / bound DB service and
#  read from VCAP_SERVICES automatically (see packages/core/src/config.ts).
# ──────────────────────────────────────────────────────────────────────────

# 'development' | 'production' | 'test'
NODE_ENV=development

# Port the API/host listens on. Cloud Foundry injects PORT automatically.
PORT=8080

# Public base URL of the app (used to build the OIDC redirect URI).
BASE_URL=http://localhost:8080

# ── Authentication ─────────────────────────────────────────────────────────
# 'entra' uses real Microsoft Entra ID (Azure AD) OIDC.
# 'mock'  uses a built-in fake login for local dev (NEVER use in production).
AUTH_MODE=mock

# Entra ID (Azure AD) OIDC — fill in once IT registers the App Registration.
# Authority is the v2.0 issuer for your tenant.
OIDC_AUTHORITY=https://login.microsoftonline.com/<TENANT_ID>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults to `${BASE_URL}/auth/callback` if left blank.
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email

# Map Entra group object-ids to application roles (JSON).
# Example: {"<entra-group-guid>":"admin","<another-guid>":"editor"}
ROLE_MAPPINGS={}
# Role assigned to any authenticated user with no matching group mapping.
DEFAULT_ROLE=viewer

# ── Session ────────────────────────────────────────────────────────────────
# Comma-separated base64-encoded 32-byte keys for the encrypted session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If left blank in development a random ephemeral key is generated (sessions
# reset on restart). REQUIRED in production.
SESSION_KEYS=

# ── Database ───────────────────────────────────────────────────────────────
# Postgres connection string. In Cloud Foundry this is read from VCAP_SERVICES.
DATABASE_URL=postgres://power:power@localhost:5432/power_app

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Defaults to BASE_URL.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
